NODE_ENV=development
PORT=8787
# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Optional gold-task configuration
GOLD_TASKS_FILE=
# Frontend/API access
CORS_ORIGIN=http://localhost:8787
# Required for reviewer account bootstrap
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-secret
# Reviewer quality-control policy
REVIEWER_MIN_CALIBRATION_ATTEMPTS=3
REVIEWER_PASS_CALIBRATION_ACCURACY=0.8
REVIEWER_WARNING_CALIBRATION_ACCURACY=0.7
REVIEWER_WARNING_SCORE=3
REVIEWER_SUSPENSION_SCORE=2
REVIEWER_MAX_CONSECUTIVE_FAILURES=3
# Security rate limiting
SECURITY_RATE_WINDOW_MS=60000
SECURITY_RATE_MAX_REQUESTS=120
