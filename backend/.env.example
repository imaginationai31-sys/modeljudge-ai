PORT=8787
# Leave unset for local JSONL storage.
DATABASE_URL=
# Set to false only for a local PostgreSQL server without TLS.
DATABASE_SSL=true
DATABASE_POOL_MAX=10
# Restrict browser access in production. Example: https://app.example.com
CORS_ORIGIN=http://localhost:8000
# One-time bootstrap secret for creating reviewer accounts. Never commit the real value.
ADMIN_BOOTSTRAP_TOKEN=
# Production: point this to a private file outside the public repository.
# The service never returns expected_preference to reviewers.
GOLD_TASKS_FILE=/secure/modeljudge/gold-evaluations.jsonl
# Reviewer quality policy
REVIEWER_MIN_CALIBRATION_ATTEMPTS=3
REVIEWER_PASS_CALIBRATION_ACCURACY=0.8
REVIEWER_WARNING_CALIBRATION_ACCURACY=0.6
REVIEWER_WARNING_SCORE=0.8
REVIEWER_SUSPENSION_SCORE=0.5
REVIEWER_MAX_CONSECUTIVE_FAILURES=3
