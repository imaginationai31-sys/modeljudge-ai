{
  "name": "modeljudge-ai-api",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first API and dataset engine for ModelJudge AI human preference evaluations",
  "main": "server.js",
  "scripts": {
    "start": "node ../scripts/start.js",
    "dev": "node --watch server.js",
    "validate": "node ../scripts/validate-dataset.js",
    "export": "node ../scripts/dataset-engine.js",
    "filter": "node ../scripts/quality-filter.js",
    "reliability": "node ../scripts/reliability-report.js",
    "reviewer-control": "node ../scripts/reviewer-quality-control.js",
    "certification": "node ../scripts/certification-report.js",
    "release": "node ../scripts/create-release.js",
    "buyer-key": "node ../scripts/create-buyer-key.js",
    "migrate": "node ../scripts/migrate.js",
    "test": "node --experimental-test-coverage --test-coverage-lines=60 --test-coverage-functions=60 --test-coverage-statements=60 --test-coverage-branches=50 --test ../tests/*.test.js",
    "test:unit": "node --test ../tests/*.test.js --test-name-pattern='^(?!.*HTTP API integration)'",
    "test:integration": "node --test ../tests/api.integration.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=60 --test-coverage-functions=60 --test-coverage-statements=60 --test-coverage-branches=50 --test ../tests/*.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "10.10.0"
  }
}
